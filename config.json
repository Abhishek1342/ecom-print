{
  "platforms": {
    "Amazon": {
      "filename_patterns": [
        "document"
      ],
      "page_margin_top": 7,
      "page_margin_bottom": 7,
      "page_margin_left": 7,
      "page_margin_right": 7,
      "page1_challan": {
        "crop_margin": {
          "top": 0,
          "bottom": 0,
          "left": 0,
          "right": 0
        },
        "rotate_degrees": 0,
        "scale_factor": 1.0,
        "positioning": "auto-fit"
      },
      "page2_invoice": {
        "crop_margin": {
          "top": 0,
          "bottom": 0,
          "left": 0,
          "right": 0
        },
        "rotate_degrees": 0,
        "scale_factor": 1.0,
        "positioning": "auto-fit"
      }
    },
    "Flipkart": {
      "filename_patterns": [
        "invoice_labels_"
      ],
      "multi_page_input": true,
      "orders_per_page": 1,
      "page_margin_top": 7,
      "page_margin_bottom": 7,
      "page_margin_left": 7,
      "page_margin_right": 7,
      "split_ratio": 0.5,
      "page_gutter_v": 6,
      "challan_quadrant_single": 1,
      "invoice_quadrant_single": 2,
      "challan_quadrant_pair": [
        1,
        3
      ],
      "invoice_quadrant_pair": [
        2,
        4
      ],
      "page_challan": {
        "crop_bottom_at_text": "Tax Invoice",
        "auto_crop": true,
        "crop_padding": 3,
        "rotate_degrees": 0,
        "crop_margin": { "top": 0, "bottom": 9, "left": 0, "right": 0 }
      },
      "page_invoice": {
        "crop_top_at_text": "Tax Invoice",
        "auto_crop": true,
        "crop_padding": 3,
        "rotate_degrees": 90
      }
    },
    "JioMart": {
      "filename_patterns": [
        "JioMart"
      ],
      "page_margin_top": 7,
      "page_margin_bottom": 7,
      "page_margin_left": 7,
      "page_margin_right": 7,
      "challan_page_index": 1,
      "invoice_page_index": 0,
      "split_ratio": 0.5,
      "challan_quadrant_single": 2,
      "invoice_quadrant_single": 1,
      "challan_quadrant_pair": [
        2,
        4
      ],
      "invoice_quadrant_pair": [
        1,
        3
      ],
      "page_invoice": {
        "auto_crop": true,
        "crop_padding": 5,
        "rotate_degrees": 0
      },
      "page_challan": {
        "auto_crop": true,
        "crop_padding": 5,
        "rotate_degrees": 90
      }
    },
    "Meesho": {
      "filename_patterns": [
        "Sub_Order_Labels_"
      ],
      "page_margin_top": 7,
      "page_margin_bottom": 7,
      "page_margin_left": 7,
      "page_margin_right": 7,
      "challan_page_index": 0,
      "invoice_page_index": 0,
      "split_ratio": 0.5,
      "challan_quadrant_single": 1,
      "invoice_quadrant_single": 2,
      "challan_quadrant_pair": [
        1,
        3
      ],
      "invoice_quadrant_pair": [
        2,
        4
      ],
      "page_challan": {
        "crop_bottom_at_text": "TAX INVOICE",
        "auto_crop": true,
        "crop_padding": 5,
        "rotate_degrees": 90
      },
      "page_invoice": {
        "crop_top_at_text": "TAX INVOICE",
        "auto_crop": true,
        "crop_padding": 5,
        "rotate_degrees": 90
      }
    }
  },
  "printer_settings": {
    "target_page_size": "A4",
    "printer_margin": {
      "top": 0,
      "bottom": 0,
      "left": 0,
      "right": 0
    },
    "quadrant_layout": {
      "Q1": "Order1_Challan",
      "Q2": "Order1_Invoice",
      "Q3": "Order2_Challan",
      "Q4": "Order2_Invoice"
    }
  }
}